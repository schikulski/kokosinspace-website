# Neon Postgres (pooled connection string)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Admin login (shared)
ADMIN_USERNAME=kokos
ADMIN_PASSWORD=change-me
# Random 32+ char secret used to sign the session cookie
AUTH_SECRET=change-me-to-a-long-random-string

# Vercel Blob (set automatically when the Blob store is linked in Vercel)
BLOB_READ_WRITE_TOKEN=

# MailerLite
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=100295749053450079
